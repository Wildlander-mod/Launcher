{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "tsBuildInfoFile": "dist/main.tsbuildinfo"
  },
  "include": [
    "src/main.ts",
    "src/main/**/*.ts",
    "src/shared/**/*.ts",
    "src/shared/**/*.json",
    "src/preload/**/*.ts",
    "src/**/*.d.ts"
  ]
}
