{
  "name": "wildlander-launcher",
  "version": "2.19.0",
  "description": "A launcher for the Wildlander Wabbajack modpack",
  "author": "Wildlander",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:dist": "electron-vite build && electron-builder",
    "build:dist:dir": "electron-vite build && electron-builder --dir",
    "lint": "npm run lint:typescript && npm run lint:eslint && npm run lint:styles && npm run lint:prettier",
    "lint:fix": "npm run lint:typescript && npm run lint:eslint:fix && npm run lint:prettier:fix",
    "lint:eslint": "eslint src --ext .ts,.vue,.js",
    "lint:eslint:fix": "eslint src --ext .ts,.vue,.js --fix",
    "lint:styles": "stylelint **/*.scss",
    "lint:typescript": "tsc -b ./tsconfig.json",
    "lint:prettier": "prettier -l 'src/**/*.{ts,tsx,js,jsx,vue,json,scss,css}'",
    "lint:prettier:fix": "npm run lint:prettier -- --write",
    "postinstall": "electron-builder install-app-deps",
    "postuninstall": "electron-builder install-app-deps",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "npm run test:unit:main && npm run test:unit:renderer",
    "test:unit:main": "lb-nyc cross-env TS_NODE_PROJECT=./tsconfig.renderer.json lb-mocha",
    "test:unit:renderer": "jest",
    "pretest:e2e": "npm run build:dist:dir",
    "test:e2e": "playwright test --grep-invert @screenshot",
    "test:e2e:screenshot": "docker compose run --rm --build e2e-tests",
    "test:e2e:screenshot:update": "docker compose run --rm --build e2e-tests-update-screenshots",
    "test:e2e:screenshot:ci": "docker compose run --build e2e-tests-ci",
    "test:e2e:headless": "docker compose run --rm --build e2e-tests-headless",
    "test:e2e:show-report": "npx playwright show-report .playwright/report",
    "generate:modpack-files": "ts-node src/__tests__/e2e/util/generate-modpack-files.ts"
  },
  "main": "./out/main/index.js",
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@loopback/context": "^5.0.10",
    "@loopback/core": "^4.0.10",
    "@vueform/toggle": "^2.1.1",
    "electron-context-menu": "^3.4.0",
    "electron-log": "^5.4.2",
    "electron-shutdown-command": "^2.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^4.6.5",
    "fetch-installed-software": "^0.0.7",
    "fs-extra": "^11.1.1",
    "js-ini": "^1.6.0",
    "junk": "^3.1.0",
    "mitt": "^3.0.0",
    "node-fetch": "^2.6.7",
    "ps-list": "^7.2.0",
    "tslib": "^2.0.0",
    "vue": "^3.2.31",
    "vue-final-modal": "^3.4.4",
    "vue-router": "^4.1.3",
    "vue3-click-away": "^1.2.4",
    "vue3-popper": "^1.5.0"
  },
  "devDependencies": {
    "@babel/plugin-proposal-class-properties": "^7.16.7",
    "@babel/preset-typescript": "^7.16.5",
    "@commitlint/config-conventional": "^15.0.0",
    "@istanbuljs/nyc-config-typescript": "^1.0.2",
    "@loopback/build": "^9.0.10",
    "@loopback/eslint-config": "^14.0.2",
    "@loopback/testlab": "^5.0.10",
    "@playwright/test": "^1.59.1",
    "@swc/core": "^1.13.3",
    "@tsconfig/node16-strictest": "^1.0.4",
    "@tsconfig/strictest": "^2.0.1",
    "@types/fs-extra": "^9.0.13",
    "@types/ini": "^1.3.31",
    "@types/jest": "^26.0.24",
    "@types/mocha": "^10.0.1",
    "@types/mock-fs": "^4.13.1",
    "@types/mock-require": "^2.0.1",
    "@types/ncp": "^2.0.5",
    "@types/node": "^22.19.17",
    "@types/node-fetch": "^2.6.1",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.9",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/compiler-sfc": "^3.2.26",
    "@vue/eslint-config-prettier": "^7.1.0",
    "@vue/eslint-config-standard": "^8.0.1",
    "@vue/eslint-config-typescript": "^11.0.3",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.4.0",
    "babel-eslint": "^10.1.0",
    "babel-plugin-istanbul": "^5.2.0",
    "commitlint": "^15.0.0",
    "cross-env": "^7.0.3",
    "electron": "^16.0.5",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^8.42.0",
    "eslint-plugin-import": "^2.25.3",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^3.4.1",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-standard": "^4.0.0",
    "eslint-plugin-vue": "^9.14.1",
    "jest": "^26.6.3",
    "lint-staged": "^12.1.3",
    "mocha": "^10.2.0",
    "mock-fs": "^5.5.0",
    "mock-require": "^3.0.3",
    "nock": "^13.5.4",
    "nyc": "^15.1.0",
    "playwright": "^1.59.1",
    "prettier": "^2.8.7",
    "reflect-metadata": "^0.1.13",
    "sass-embedded": "^1.90.0",
    "stylelint": "^13.12.0",
    "stylelint-config-recommended-scss": "^4.3.0",
    "stylelint-scss": "^3.21.0",
    "ts-jest": "^26.5.6",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.6.4",
    "tsconfig-paths": "^4.0.0",
    "typescript": "~4.9.5",
    "vite": "^6.3.5",
    "vue-jest": "^5.0.0-alpha.10",
    "xvfb-maybe": "^0.2.1",
    "yorkie": "^2.0.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "footer-max-line-length": [
        0,
        "always"
      ]
    },
    "parserPreset": {
      "parserOpts": {
        "noteKeywords": [
          "docs:"
        ]
      }
    }
  },
  "gitHooks": {
    "pre-commit": "lint-staged",
    "commit-msg": "commitlint -e -V "
  },
  "repository": "https://github.com/Wildlander-mod/Launcher",
  "build": {
    "productName": "Wildlander Launcher",
    "icon": "public/images/logos/wildlander-icon-light.png",
    "publish": {
      "provider": "github",
      "releaseType": "release"
    },
    "files": [
      "out/**",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "./resources/tools/",
        "to": "tools",
        "filter": [
          "**/*"
        ]
      }
    ],
    "nsis": {
      "deleteAppDataOnUninstall": true
    }
  }
}
